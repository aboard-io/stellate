# Renders are DERIVED from royal-road.csd — never committed, always regenerable.
# The source is the capability; the audio is disposable. (This is the whole point.)
*.wav
*.mp3
*.aiff
*.flac
*.ogg
*.m4a
*.aac
*.aif

# Claude Code session state — never committed, never deployed
.claude/

# rendered/cached video artifacts are never committed (the media guard's law)
*.mp4
*.webm

# audio-verifier deps: venv + Essentia models are derived (see CLAUDE.md)
.venv-verify/
models/

# Scratch states from `genre-kernel.js track <genre>` land in the root —
# derived, regenerable, never committed.
/*.state.json
/node_modules/
engine/faust/node_modules/
tools/node_modules/
# webfont bytes fetched by tools/build/gen-og-card.js so the card renders offline and
# byte-identically. Derived (Google Fonts is the source); ship.sh rsyncs the
# working tree, so this must never ride along to the droplet.
tools/.font-cache/
.venv-sing/
journey/

# scratch/ — parked derived renders & state.jsons (regenerable via seeds)
scratch/

# The RELEASE FEED (tools/build/gen-feed.js) is DERIVED from the git log — the recipe
# is committed, the artifacts are not (the one rule). tools/deploy/deploy-stellate.sh
# regenerates all four just before the rsync, so the deployed feed always
# includes the commit being deployed. docs/HOSTING.md "The open-web layer" §2.
/feed.xml
/feed.json
/feed-archive.xml
/feed-archive.json
__pycache__/

# scratchpad/ — session working files (screenshots, probes); never tracked
scratchpad/

# a 6 MB rendered mp3 is a derived artifact; the record, its .mid and its score are the keep
keeps/**/*.mp3
tools/genre-qa/*.db

# the remix tool writes demo rows here; they are derived, not catalogue
tools/remix-out/
