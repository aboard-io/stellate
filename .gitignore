# Renders are DERIVED from royal-road.csd — never committed, always regenerable.
# The source is the capability; the audio is disposable. (This is the whole point.)
*.wav
*.mp3
*.aiff
*.flac

# found-video clips are DERIVED via fetch-found-video.sh — never committed
*.mp4
*.webm

# audio-verifier deps: venv + Essentia models are derived (see CLAUDE.md)
.venv-verify/
models/

# Scratch states from `genre-kernel.js track <genre>` land in the root —
# derived, regenerable. The intentional demo sets live in playlist/ and mix/,
# which the leading slash leaves tracked.
/*.state.json
faust/node_modules/
.venv-sing/
journey/

# scratch/ — parked derived renders & state.jsons (regenerable via seeds)
scratch/
