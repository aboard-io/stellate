include "microw8-api.cwa"
export fn upd() {
    let inline t = time();
    let inline lx = 160 as f32 + sin(t) * 150 as f32;
    let inline ly = 120 as f32 + cos(t * 1.3) * 110 as f32;
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32;
        let inline y = (i #/ 320) as f32;
        let inline dx = x - lx;
        let inline dy = y - ly;
        let inline d = sqrt(dx*dx + dy*dy);
        let inline bump = sin(x * 0.1) * cos(y * 0.1 + t);
        let inline cf = max(0 as f32, min(63 as f32, 63 as f32 - d * 0.4 + bump * 20 as f32));
        i?FRAMEBUFFER = (cf as i32) + 200;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
