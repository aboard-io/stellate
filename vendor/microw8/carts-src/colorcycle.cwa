include "microw8-api.cwa"
export fn start() {
    let i: i32;
    loop pal {
        let inline f = i as f32 / 255 as f32 * 6.28 * 3 as f32;
        (i*4)!PALETTE = ((sin(f)*127 as f32+128 as f32) as i32) | (((sin(f*1.3)*127 as f32+128 as f32) as i32)<<8) | (((sin(f*0.7)*127 as f32+128 as f32) as i32)<<16);
        branch_if (i := i + 1) < 256: pal;
    }
}
export fn upd() {
    let inline ti = (time() * 40 as f32) as i32;
    let i: i32;
    loop pixels {
        i?FRAMEBUFFER = (((i % 320) ^ (i #/ 320)) + ti) & 255;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
