include "microw8-api.cwa"
export fn start() {
    let i: i32;
    loop pal {
        let inline f = i as f32 / 47 as f32;
        let inline r = min(255 as f32, f * 3 as f32 * 255 as f32) as i32;
        let inline g = min(255 as f32, max(0 as f32, (f - 0.33) * 3 as f32) * 255 as f32) as i32;
        let inline b = min(255 as f32, max(0 as f32, (f - 0.66) * 3 as f32) * 255 as f32) as i32;
        (i * 4)!PALETTE = r | (g << 8) | (b << 16);
        branch_if (i := i + 1) < 48: pal;
    }
}
export fn upd() {
    let x: i32;
    loop seed {
        (239*320 + x)?FRAMEBUFFER = 24 + (random() & 23);
        branch_if (x := x + 1) < 320: seed;
    }
    let i: i32;
    loop prop {
        let inline s = (i+320)?FRAMEBUFFER + (i+319)?FRAMEBUFFER + (i+321)?FRAMEBUFFER + (i+640)?FRAMEBUFFER;
        let inline avg = s #/ 4;
        i?FRAMEBUFFER = avg - (avg > 0);
        branch_if (i := i + 1) < 239*320: prop;
    }
}
