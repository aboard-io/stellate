include "microw8-api.cwa"
export fn start() {
    let i: i32;
    loop pal {
        let inline f = i as f32 / 63 as f32;
        (i*4)!PALETTE = (f*200 as f32) as i32 | (((f*120 as f32) as i32)<<8) | (((f*255 as f32) as i32)<<16);
        branch_if (i := i + 1) < 64: pal;
    }
}
export fn upd() {
    let inline t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline yy = max(y, 0.5);
        let inline z = 3000 as f32 / yy;
        let inline u = (x * z * 0.02) as i32;
        let inline v = (z + t * 120 as f32) as i32;
        let inline c = (((u ^ v) & 32) + (v & 31) + 200) * (y > 0.5);
        i?FRAMEBUFFER = c;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
