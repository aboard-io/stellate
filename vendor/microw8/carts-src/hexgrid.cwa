include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 * 0.06;
        let inline y = (i #/ 320) as f32 * 0.06;
        let inline v = sin(x + t) + sin(y - t) + sin(x + y + t * 1.5) + sin(sqrt(x*x+y*y)*2 as f32 - t*2 as f32);
        i?FRAMEBUFFER = (v * 16 as f32) as i32 + 216;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
