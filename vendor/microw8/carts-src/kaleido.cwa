include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline a = atan2(y, x) * 6 as f32 + t;
        let inline r = sqrt(x*x + y*y) * 0.05;
        let inline v = sin(a) + sin(r * 4 as f32 - t * 2 as f32) + cos(a * 0.5 + r);
        i?FRAMEBUFFER = (v * 20 as f32) as i32 + 216;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
