include "microw8-api.cwa"
export fn upd() {
    cls(0);
    let t = time();
    let i: i32;
    loop pts {
        let inline p = i as f32 * 0.03;
        let inline x = 160 as f32 + sin(p * 3 as f32 + t) * 150 as f32;
        let inline y = 120 as f32 + sin(p * 2 as f32 + t * 1.3) * 110 as f32;
        circle(x, y, 1.5, (i & 63) + 200);
        branch_if (i := i + 1) < 400: pts;
    }
}
