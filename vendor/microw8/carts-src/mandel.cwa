include "microw8-api.cwa"
export fn upd() {
    let inline t = time();
    let inline zoom = 1.5 / (sin(t * 0.3) * 0.5 + 0.9);
    let i: i32;
    loop pixels {
        let inline px = ((i % 320) as f32 - 160 as f32) / 160 as f32 * zoom - 0.75;
        let inline py = ((i #/ 320) as f32 - 120 as f32) / 120 as f32 * zoom + sin(t*0.2)*0.1;
        let zx = px;
        let zy = py;
        let n = 0;
        let esc = 0;
        let k = 0;
        loop iter {
            let inline xx = zx*zx;
            let inline yy = zy*zy;
            esc = esc | ((xx + yy) > 4.0);
            n = n + (esc == 0);
            let inline nzy = 2.0 * zx * zy + py;
            zx = xx - yy + px;
            zy = nzy;
            branch_if (k := k + 1) < 28: iter;
        }
        i?FRAMEBUFFER = (n * 4 + 200) * (n < 28);
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
