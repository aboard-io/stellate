include "microw8-api.cwa"
export fn start() {
    let i: i32;
    loop pal {
        let inline f = i as f32 / 63 as f32;
        (i * 4)!PALETTE = (f*255 as f32) as i32 | (((f*f)*255 as f32) as i32 << 8) | ((sqrt(f)*255 as f32) as i32 << 16);
        branch_if (i := i + 1) < 64: pal;
    }
}
export fn upd() {
    let t = time();
    let inline ax = 160 as f32 + sin(t) * 110 as f32;
    let inline ay = 120 as f32 + cos(t*1.3) * 90 as f32;
    let inline bx = 160 as f32 + sin(t*0.7+2 as f32) * 120 as f32;
    let inline by = 120 as f32 + cos(t*0.9+1 as f32) * 80 as f32;
    let inline cx = 160 as f32 + sin(t*1.1+4 as f32) * 100 as f32;
    let inline cy = 120 as f32 + cos(t*0.6+3 as f32) * 95 as f32;
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32;
        let inline y = (i #/ 320) as f32;
        let inline d1 = 4000 as f32 / ((x-ax)*(x-ax) + (y-ay)*(y-ay) + 1 as f32);
        let inline d2 = 4000 as f32 / ((x-bx)*(x-bx) + (y-by)*(y-by) + 1 as f32);
        let inline d3 = 4000 as f32 / ((x-cx)*(x-cx) + (y-cy)*(y-cy) + 1 as f32);
        let inline c = min(63 as f32, (d1+d2+d3) * 8 as f32) as i32;
        i?FRAMEBUFFER = c;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
