include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let inline ax = 160 as f32 + sin(t) * 80 as f32;
    let inline ay = 120 as f32 + cos(t*1.2) * 60 as f32;
    let inline bx = 160 as f32 - sin(t*0.8) * 80 as f32;
    let inline by = 120 as f32 - cos(t) * 60 as f32;
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32;
        let inline y = (i #/ 320) as f32;
        let inline d1 = sqrt((x-ax)*(x-ax) + (y-ay)*(y-ay));
        let inline d2 = sqrt((x-bx)*(x-bx) + (y-by)*(y-by));
        let inline v = sin(d1 * 0.3) + sin(d2 * 0.3 - t);
        i?FRAMEBUFFER = (v * 20 as f32) as i32 + 216;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
