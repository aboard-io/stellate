include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let y: i32;
    loop rows {
        let inline w = sin(y as f32 * 0.05 + t * 2 as f32) + sin(y as f32 * 0.02 - t * 3 as f32);
        let inline c = (w * 20 as f32) as i32 + 240;
        hline(0, 320, y, c);
        branch_if (y := y + 1) < 240: rows;
    }
}
