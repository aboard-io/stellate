include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline d = sqrt(x*x + y*y);
        let inline w = sin(d * 0.15 - t * 4 as f32) + sin(d * 0.07 - t * 2 as f32);
        i?FRAMEBUFFER = (w * 16 as f32) as i32 + 216;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
