include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let inline s = sin(t * 0.6) * 0.008 + 0.014;
    let inline ca = cos(t * 0.7) * s;
    let inline sa = sin(t * 0.7) * s;
    let inline ox = sin(t) * 128 as f32;
    let inline oy = cos(t * 0.5) * 128 as f32;
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline u = (x * ca - y * sa) * 128 as f32 + ox;
        let inline v = (x * sa + y * ca) * 128 as f32 + oy;
        i?FRAMEBUFFER = ((u as i32 ^ v as i32) & 63) + 200;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
