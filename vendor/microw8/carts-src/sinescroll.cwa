include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32;
        let inline y = (i #/ 320) as f32;
        let inline wave = 120 as f32 + sin(x * 0.03 + t * 2 as f32) * 60 as f32 + sin(x * 0.07 - t) * 30 as f32;
        let inline d = (y - wave);
        i?FRAMEBUFFER = ((sqrt(d*d) * 0.5) as i32 & 63) + 200;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
