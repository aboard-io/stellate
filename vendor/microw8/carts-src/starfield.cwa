include "microw8-api.cwa"
export fn upd() {
    cls(0);
    let t = time();
    let i: i32;
    loop stars {
        randomSeed(i + 1);
        let inline sx = randomf() * 2 as f32 - 1 as f32;
        let inline sy = randomf() * 2 as f32 - 1 as f32;
        let inline z = fmod(randomf() * 5 as f32 + t, 5 as f32) + 0.05;
        let inline px = 160 as f32 + sx / z * 160 as f32;
        let inline py = 120 as f32 + sy / z * 160 as f32;
        let inline b = (48 as f32 - z * 8 as f32) as i32;
        circle(px, py, (2 as f32 - z*0.3), b + 200);
        branch_if (i := i + 1) < 300: stars;
    }
}
