include "microw8-api.cwa"
export fn start() {
    let i: i32;
    loop pal {
        let inline f = i as f32 / 63 as f32 * 6.28;
        (i*4)!PALETTE = ((sin(f)*127 as f32+128 as f32) as i32) | (((sin(f+2 as f32)*100 as f32+120 as f32) as i32)<<8) | (((sin(f+4 as f32)*127 as f32+128 as f32) as i32)<<16);
        branch_if (i := i + 1) < 64: pal;
    }
}
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline r = sqrt(x*x + y*y) + 1 as f32;
        let inline u = (2000 as f32 / r + t * 30 as f32) as i32;
        let inline a = (atan2(y, x) * 40 as f32) as i32;
        i?FRAMEBUFFER = ((u ^ a) & 63);
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
