include "microw8-api.cwa"
export fn upd() {
    cls(0);
    let t = time();
    let y: i32;
    loop rows {
        let inline a = y as f32 * 0.04 + t * 2 as f32;
        let inline c0 = sin(a) * 80 as f32;
        let inline c1 = sin(a + 1.57) * 80 as f32;
        let inline c2 = sin(a + 3.14) * 80 as f32;
        let inline c3 = sin(a + 4.71) * 80 as f32;
        line(160 as f32 + c0, y as f32, 160 as f32 + c1, y as f32, 40);
        line(160 as f32 + c1, y as f32, 160 as f32 + c2, y as f32, 32);
        line(160 as f32 + c2, y as f32, 160 as f32 + c3, y as f32, 40);
        line(160 as f32 + c3, y as f32, 160 as f32 + c0, y as f32, 48);
        branch_if (y := y + 1) < 240: rows;
    }
}
