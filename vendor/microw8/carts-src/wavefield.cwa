include "microw8-api.cwa"
export fn upd() {
    let t = time();
    let i: i32;
    loop pixels {
        let inline x = (i % 320) as f32 - 160 as f32;
        let inline y = (i #/ 320) as f32 - 120 as f32;
        let inline gx = sin(x * 0.1 + t) * 8 as f32;
        let inline gy = sin(y * 0.1 - t * 1.3) * 8 as f32;
        let inline v = sin((x + gy) * 0.08) * cos((y + gx) * 0.08 + t);
        i?FRAMEBUFFER = (v * 24 as f32) as i32 + 216;
        branch_if (i := i + 1) < 320*240: pixels;
    }
}
